---
import Form from "./contact_components/Form.astro";
---

<section>
    <div class="contact-header">
        <p class="contact-subheader">05 / LET'S CONNECT</p>
        <h2>
            Szukasz samodzielnego specjalisty IT?<br /><span
                >Porozmawiajmy.</span
            >
        </h2>
        <p class="paragraph-header">
            IT Support L1/L2/L3 lub Junior / Mid Sysadmin? <br />
            Chętnie porozmawiam o Twojej infrastrukturze, wyzwaniach zespołu i tym,
            jak mogę pomóc.
        </p>
        <div class="copy-button-header">
            <div class="icon-and-contact-wrapper">
                <span class="icon-wrapper"
                    ><svg
                        width="18"
                        height="18"
                        viewBox="0 0 18 18"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path
                            d="M3 3H15C15.8284 3 16.5 3.67157 16.5 4.5V13.5C16.5 14.3284 15.8284 15 15 15H3C2.17157 15 1.5 14.3284 1.5 13.5V4.5C1.5 3.67157 2.17157 3 3 3Z"
                            stroke-width="1.275"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke="#7CC6FE"></path>
                        <path
                            d="M16.5 5.25L9.7725 9.525C9.54095 9.67007 9.27324 9.74701 9 9.74701C8.72676 9.74701 8.45905 9.67007 8.2275 9.525L1.5 5.25"
                            stroke-width="1.275"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke="#7CC6FE"></path>
                    </svg>
                </span>
                <div class="contact-info">
                    <span>BEZPOŚREDNI KONTAKT</span>
                    <p>kontakt@example.com</p>
                </div>
            </div>

            <button class="copy-btn"
                ><svg
                    width="18"
                    height="18"
                    viewBox="0 0 18 18"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                >
                    <path
                        d="M7.5 6H15C15.8284 6 16.5 6.67157 16.5 7.5V15C16.5 15.8284 15.8284 16.5 15 16.5H7.5C6.67157 16.5 6 15.8284 6 15V7.5C6 6.67157 6.67157 6 7.5 6Z"
                        stroke-width="1.275"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke="#9AACC2"></path>
                    <path
                        d="M3 12C2.175 12 1.5 11.325 1.5 10.5V3C1.5 2.175 2.175 1.5 3 1.5H10.5C11.325 1.5 12 2.175 12 3"
                        stroke-width="1.275"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke="#9AACC2"></path>
                </svg>
                Kopiuj</button
            >
        </div>
        <div class="header-icons-sm">
            <div class="sm-icon">
                <svg
                    width="18"
                    height="18"
                    viewBox="0 0 18 18"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                >
                    <path
                        d="M12 6C13.1935 6 14.3381 6.47411 15.182 7.31802C16.0259 8.16193 16.5 9.30653 16.5 10.5V15.75H13.5V10.5C13.5 10.1022 13.342 9.72064 13.0607 9.43934C12.7794 9.15804 12.3978 9 12 9C11.6022 9 11.2206 9.15804 10.9393 9.43934C10.658 9.72064 10.5 10.1022 10.5 10.5V15.75H7.5V10.5C7.5 9.30653 7.97411 8.16193 8.81802 7.31802C9.66193 6.47411 10.8065 6 12 6Z"
                        stroke-width="1.275"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke="#98ABC3"></path>
                    <path
                        d="M1.5 6.75H4.5V15.75H1.5V6.75Z"
                        stroke-width="1.275"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke="#98ABC3"></path>
                    <path
                        d="M4.5 3C4.5 3.82843 3.82843 4.5 3 4.5C2.17157 4.5 1.5 3.82843 1.5 3C1.5 2.17157 2.17157 1.5 3 1.5C3.82843 1.5 4.5 2.17157 4.5 3Z"
                        stroke-width="1.275"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke="#98ABC3"></path>
                </svg>

                <span>LinkedIn</span>
                <svg
                    width="18"
                    height="18"
                    viewBox="0 0 18 18"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                >
                    <path
                        d="M5.25 5.25H12.75V12.75"
                        stroke-width="1.275"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke="#98ABC3"></path>
                    <path
                        d="M5.25 12.75L12.75 5.25"
                        stroke-width="1.275"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke="#98ABC3"></path>
                </svg>
            </div>
            <div class="sm-icon">
                <svg
                    width="18"
                    height="18"
                    viewBox="0 0 18 18"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                >
                    <path
                        d="M11.25 16.5V13.5C11.3544 12.5605 11.085 11.6176 10.5 10.875C12.75 10.875 15 9.375 15 6.75C15.06 5.8125 14.7975 4.89 14.25 4.125C14.46 3.2625 14.46 2.3625 14.25 1.5C14.25 1.5 13.5 1.5 12 2.625C10.02 2.25 7.98003 2.25 6.00003 2.625C4.50003 1.5 3.75003 1.5 3.75003 1.5C3.52503 2.3625 3.52503 3.2625 3.75003 4.125C3.20393 4.88691 2.93888 5.81459 3.00003 6.75C3.00003 9.375 5.25003 10.875 7.50003 10.875C7.20753 11.2425 6.99003 11.6625 6.86253 12.1125C6.73503 12.5625 6.69753 13.035 6.75003 13.5V16.5"
                        stroke-width="1.275"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke="#98ABC3"></path>
                    <path
                        d="M6.75 13.5C3.3675 15 3 12 1.5 12"
                        stroke-width="1.275"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke="#98ABC3"></path>
                </svg>

                <span>GitHub</span>
                <svg
                    width="18"
                    height="18"
                    viewBox="0 0 18 18"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                >
                    <path
                        d="M5.25 5.25H12.75V12.75"
                        stroke-width="1.275"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke="#98ABC3"></path>
                    <path
                        d="M5.25 12.75L12.75 5.25"
                        stroke-width="1.275"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke="#98ABC3"></path>
                </svg>
            </div>
        </div>
    </div>
    <Form />
</section>

<style>
    section {
        width: 100%;
        max-width: 84rem;
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        gap: 3rem;

        padding: 1.25rem;
        margin-inline: auto;
        border-bottom: 2px solid #1a2638;
    }
    .contact-header {
        display: flex;
        flex-direction: column;
        flex-wrap: nowrap;
        gap: 1rem;
    }

    .contact-subheader {
        color: #7cc6fe;
        letter-spacing: 1px;
        font-size: 12px;
    }
    h2 {
        line-height: 23px;
        letter-spacing: -1px;
        color: #eaf0f8;
        > span {
            color: #7cc6fe;
        }
    }
    .paragraph-header {
        color: #8d9db2;
        line-height: 23px;
        font-size: 14px;
    }

    .copy-button-header {
        display: flex;
        flex-direction: row;
        flex-wrap: nowrap;
        padding: 1rem 1rem;
        gap: 1rem;
        justify-content: space-between;
        align-items: center;

        background-color: #101d2e;
        border-radius: 10px;
        border: 2px solid #2b3f56;
    }

    .contact-info {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        gap: 0.5rem;
        > span {
            color: #8093ac;
            font-size: 12px;
        }
        > p {
            line-height: 21px;
            color: #eaf0f8;
        }
    }
    .icon-wrapper {
        display: inline-block;
    }
    .icon-and-contact-wrapper {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        gap: 1rem;
    }

    .copy-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;

        background: none;
        border: none;

        font-size: 12px;
        color: #9aacc2;
        > svg {
            width: auto;
            height: 1.5rem;
        }
    }

    .sm-icon {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.5rem;
        color: #98abc3;
        font-size: 12px;
        line-height: 16px;
        cursor: pointer;
        > svg {
            height: 1.5rem;
            width: auto;
        }
    }

    .header-icons-sm {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 2rem;
        flex-wrap: nowrap;
    }
</style>
