<style>
    section {
        /* Pełna szerokość (100%), aby dolna linia (border-bottom) sięgała od krawędzi do krawędzi ekranu również powyżej 1330px */
        width: 100%;
        min-width: 20rem; /* 320px */
        border-bottom: 2px solid #1a2638;
        padding-block: 3rem;
    }

    .contact-wrapper {
        /* Wewnętrzny kontener ograniczający treść do 1330px (83.125rem) i centrujący ją na większych ekranach */
        width: 100%;
        max-width: 83.125rem; /* 1330px */
        margin-inline: auto;
        padding-inline: 1rem;
        /* Mobile-first: 1 kolumna na telefonach i mniejszych tabletach */
        display: grid;
        grid-template-columns: 1fr;
        gap: 2.5rem;
        align-items: start;
    }

    .contact-header {
        display: flex;
        flex-direction: column;
        flex-wrap: nowrap;
        gap: 1.25rem;
        width: 100%;
    }

    .contact-subheader {
        color: #7cc6fe;
        letter-spacing: 0.02em;
        font-family: var(--font-mono);
        line-height: 1.4;
        font-size: var(--text-xs);
    }

    h2 {
        color: #eaf0f8;
        /* Zdejmujemy balance, aby <br /> czysto oddzielało niebieskie "Porozmawiajmy." w nowej linii */
        text-wrap: wrap;
        > span {
            color: #7cc6fe;
        }
    }

    .paragraph-header {
        color: #8d9db2;
        font-size: var(--text-card);
        line-height: 1.6;
        max-width: 34rem;
    }

    .copy-button-header {
        display: flex;
        flex-direction: row;
        /* Pozwala przyciskowi "Kopiuj" bezpiecznie zawinąć się na bardzo wąskich ekranach (320px), jeśli adres e-mail będzie długi */
        flex-wrap: wrap;
        padding: 0.875rem 1rem;
        gap: 0.75rem;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        max-width: 28rem;

        background-color: #101d2e;
        border-radius: 10px;
        border: 2px solid #2b3f56;
    }

    .icon-and-contact-wrapper {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: flex-start;
        gap: 0.75rem;
        min-width: 0; /* Kluczowe w flexboxie, aby długi adres e-mail nie rozpychał rodzica poza 320px */
    }

    .icon-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .contact-info {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        gap: 0.25rem;
        min-width: 0;
        > span {
            color: #8093ac;
            font-size: var(--text-xs);
            font-family: var(--font-mono);
            line-height: 1.4;
            letter-spacing: 0.05em;
        }
        > p {
            line-height: 1.4;
            font-family: var(--font-mono);
            font-size: var(--text-base);
            font-weight: 600;
            color: #eaf0f8;
            overflow-wrap: anywhere;
        }
    }

    .copy-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.375rem;
        background: none;
        border: none;
        padding: 0.25rem 0.5rem;
        border-radius: 6px;
        font-size: var(--text-xs);
        font-family: inherit;
        color: #9aacc2;
        line-height: 1;
        cursor: pointer;
        flex-shrink: 0;
        transition: color 0.2s ease;
        > svg {
            width: auto;
            height: 1.125rem;
        }
    }

    .copy-btn:hover {
        color: #7cc6fe;
    }

    .header-icons-sm {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 1.5rem;
        flex-wrap: wrap;
        padding-top: 0.25rem;
    }

    .sm-icon {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.375rem;
        color: #98abc3;
        font-size: var(--text-sm);
        line-height: 1.4;
        text-decoration: none;
        cursor: pointer;
        transition: color 0.2s ease;
        > svg {
            height: 1.125rem;
            width: auto;
            flex-shrink: 0;
        }
    }

    .sm-icon:hover {
        color: #7cc6fe;
    }

    @media screen and (min-width: 768px) {
        section {
            padding-block: 4.5rem;
        }
        .contact-wrapper {
            padding-inline: 1.25rem;
            gap: 3rem;
        }
        .copy-button-header {
            padding: 1rem 1.25rem;
        }
    }

    @media screen and (min-width: 1024px) {
        .contact-wrapper {
            /* Na PC układ 2-kolumnowy jak na makiecie: lewa kolumna z danymi kontaktowymi i prawa z formularzem */
            grid-template-columns: 1fr 1.15fr;
            gap: 4rem;
            align-items: center;
        }
    }
</style>

<script>
    const copyBtn = document.querySelector<HTMLButtonElement>(".copy-btn");
    const emailElement =
        document.querySelector<HTMLParagraphElement>(".contact-info > p");

    if (copyBtn && emailElement) {
        const originalHTML = copyBtn.innerHTML;

        copyBtn.addEventListener("click", async () => {
            const email =
                emailElement.textContent?.trim() || "kontakt@example.com";
            try {
                await navigator.clipboard.writeText(email);
                copyBtn.textContent = "✓ Skopiowano";
                copyBtn.style.color = "#42d6a0";

                setTimeout(() => {
                    copyBtn.innerHTML = originalHTML;
                    copyBtn.style.color = "";
                }, 20000);
            } catch {
                const textarea = document.createElement("textarea");
                textarea.value = email;
                document.body.appendChild(textarea);
                textarea.select();
                document.execCommand("copy");
                document.body.removeChild(textarea);
            }
        });
    }
</script>
