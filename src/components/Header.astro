---
import Logo from "./header_components/Logo.astro";
import MenuPC from "./header_components/MenuPC.astro";
import MobileMenuAndButtons from "./header_components/MobileMenuAndButtons.astro";
---

<header>
    <Logo />
    <MenuPC />
    <MobileMenuAndButtons />
</header>

<style>
    header {
        width: 100%;
        position: sticky;
        display: flex;
        gap: 1rem;
        justify-content: space-between;
        align-items: center;
        padding-block: 1rem;
        border-bottom: 2px solid var(--border-color);
        top: 0;
        background-color: var(--color-primary);
    }
</style>
