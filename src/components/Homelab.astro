---
import Proof from "./homelab_components/Proof.astro";
---

<section id="homelab" aria-labelledby="heading-homelab">
    <div class="homelab-wrapper">
        <div class="section-header">
            <div class="header-titles">
                <p class="chapter">02&ensp;/&ensp;PROOF&ensp;OF&ensp;WORK</p>
                <h2 id="heading-homelab">Mniej deklaracji. Więcej wdrożeń.</h2>
                <p class="subtitle">
                    Mój homelab to miejsce, w którym teoria spotyka rzeczywiste
                    problemy.
                </p>
            </div>
        </div>

        <div class="list-of-proofs">
            <Proof
                headerTags={["LINUX", "ANSIBLE", "SECURITY"]}
                title="Automatyzacja i Hardening"
                newLineTitle="Infrastruktury Linux VPS (IaC)"
                challenge="ręczna konfiguracja publicznego VPS i ekspozycja usług."
                solution="9-modułowe repozytorium runbooków i playbooków Ansible (zgodnych z ansible-lint) stawiające utwardzony serwer Ubuntu LTS w mniej niż 3h. Wynik 83/100 pkt w audycie Lynis, SSH Key-Only (FIDO2/YubiKey), Traefik + Authentik SSO i redukcja ruchu botów o ~99% przez Cloudflare WAF."
                tags={["Ansible", "Ubuntu LTS", "Traefik", "Cloudflare WAF"]}
                githubUrl="https://github.com/inok-it/vps-linux-hardening-paas"
                githubLabel="Zobacz Runbooki i kod na GitHub ->"
                headerType="no-code"
                statusTag="INFRASTRUCTURE"
                lab="LAB_01"
                iconSet={1}
            />
            <Proof
                headerTags={["CONTAINERS", "CACHE", "BACKUP 3-2-1"]}
                title="Izolowane Środowisko"
                newLineTitle="Produkcyjne dla Usług Webowych (Single-Tenant)"
                challenge="wąskie gardła wydajności, izolacja usług i ochrona danych."
                solution="Odseparowane kontenery aplikacyjne, MariaDB i Redis za reverse proxy Traefik. Czterowarstwowy cache (Edge, Page, Redis, OPCache), sekrety SMTP poza bazą danych oraz automatyczne kopie zapasowe 3-2-1 do pamięci obiektowej Cloudflare R2 z testami odtwarzania."
                tags={["Docker", "MariaDB", "Redis", "Cloudflare R2"]}
                githubUrl="https://github.com/inok-it/woocommerce-self-hosted-security-cloudflare"
                githubLabel="Zobacz Runbooki i kod na GitHub ->"
                headerType="no-code"
                statusTag="SINGLE-TENANT"
                lab="LAB_02"
                iconSet={2}
            />
            <Proof
                headerTags={["BASH", "DIAGNOSTICS", "OPERATIONS"]}
                title="Diagnostyka CLI, Skrypty"
                newLineTitle="Utrzymaniowe Bash i Obsługa Incydentów"
                challenge="ręczna diagnostyka, ryzyko cichych awarii i błędów ludzkich."
                solution="Zestaw procedur operacyjnych (SOP) i skryptów Bash/Cron automatyzujących szyfrowane zrzuty baz danych, weryfikację integralności plików (Debsums, Rkhunter), analizę logów systemd/journalctl oraz natychmiastowe alerty push o awariach."
                tags={["Bash / Cron", "journalctl", "Rkhunter", "ntfy"]}
                githubUrl="https://github.com/inok-it/vps-linux-hardening-paas"
                githubLabel="Zobacz Runbooki i kod na GitHub ->"
                headerType="code"
                statusTag="AUTOMATION"
                lab="LAB_03"
                iconSet={null}
            />
        </div>
    </div>
</section>

<style>
    section {
        /* Pełna szerokość (100%), aby dolne obramowanie (border-bottom) sięgało krawędzi ekranu powyżej 1330px */
        width: 100%;
        min-width: 20rem; /* 320px */
        border-bottom: 2px solid #1a2638;
        padding-block: 3rem;
    }

    .homelab-wrapper {
        /* Wewnętrzny kontener ograniczający treść do 1330px (83.125rem) i centrujący ją na większych monitorach */
        width: 100%;
        max-width: 83.125rem; /* 1330px */
        margin-inline: auto;
        padding-inline: 1rem;
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }
    .section-header {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        width: 100%;
    }

    .header-titles {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .chapter {
        color: #7cc6fe;
        font-size: var(--text-xs);
        font-family: var(--font-mono);
        line-height: 1.4;
        letter-spacing: 0.02em;
    }

    h2 {
        color: #eaf0f8;
    }

    .subtitle {
        color: #7f8fa5;
        line-height: 1.6;
        font-size: var(--text-lead);
    }

    .list-of-proofs {
        /* Zamiast flexboxa używamy CSS Grid:
           - Mobile (od 320px): 1 kolumna na 100% szerokości
           - Tablet (od 768px): 2 kolumny
           - PC (od 1024px): 3 równe kolumny o identycznej wysokości */
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.25rem;
        width: 100%;
        align-items: stretch;
    }

    @media screen and (min-width: 768px) {
        section {
            padding-block: 4.5rem;
        }
        .homelab-wrapper {
            padding-inline: 1.25rem;
            gap: 2.5rem;
        }
        .list-of-proofs {
            grid-template-columns: repeat(2, 1fr);
            gap: 1.5rem;
        }
    }

    @media screen and (min-width: 1024px) {
        .list-of-proofs {
            grid-template-columns: repeat(3, 1fr);
        }
    }
</style>
