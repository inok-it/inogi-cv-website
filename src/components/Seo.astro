---
interface Props {
    title?: string;
    description?: string;
    canonicalUrl?: string;
    ogImage?: string;
    umamiWebsiteId?: string;
}

const {
    title = "Patryk Polak — IT Support Specialist & Junior Linux / System Administrator (Wrocław / Opole / Zdalnie)",
    description = "Inżynier Informatyki i Technik Informatyk (E.12, E.13, E.14). Administracja serwerami Linux (Ubuntu, Debian, Docker, Ansible), wsparcie IT (Help Desk, Windows 10/11, AD/GPO, LAN/PXE), sieci (DNS, SPF/DKIM/DMARC) i monitoring.",
    ogImage = "/og_image.png",
    umamiWebsiteId = "64b5cdab-2e61-46e0-8438-ad00c0ba212b",
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.origin : Astro.url.origin;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const absoluteOgImage = new URL(ogImage, siteUrl).href;

const jsonLd = {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    dateModified: "2026-10-22",
    mainEntity: {
        "@type": "Person",
        name: "Patryk Polak",
        alternateName:
            "Patryk Polak — IT Support Specialist & Junior Linux / System Administrator",
        jobTitle: "IT Support Specialist & Linux Administrator",
        description: description,
        url: canonicalUrl,
        image: absoluteOgImage,
        email: "mailto:kontakt@inogi.pl",
        address: {
            "@type": "PostalAddress",
            addressCountry: "PL",
        },
        knowsAbout: [
            "Linux System Administration",
            "Ubuntu Server LTS",
            "Linux Hardening",
            "Docker & Containerization",
            "Traefik Reverse Proxy",
            "MariaDB & Redis Caching",
            "Zero Trust Security",
            "Cloudflare WAF & R2 Storage",
            "UFW & Fail2ban",
            "Authentik SSO",
            "YubiKey / FIDO2 Authentication",
            "Bash Scripting & Automation",
            "Disaster Recovery & Backup Policies",
        ],
        sameAs: [
            "https://github.com/inok-it",
            "https://pl.linkedin.com/in/patryk-p-4437b9445",
        ],
    },
};
---

<!-- Podstawowy Config -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />
<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="shortcut icon" href="/favicon.ico" />
<meta name="generator" content={Astro.generator} />

<!-- Podstawowe Meta Tagi -->
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<meta name="robots" content="index, follow" />
<meta name="theme-color" content="#091020" />

<!-- Open Graph / Facebook / LinkedIn -->
<meta property="og:type" content="profile" />
<meta property="og:locale" content="pl_PL" />
<meta property="og:url" content={canonicalUrl} />
<meta
    property="og:site_name"
    content="Patryk Polak — IT Support Specialist & Junior Linux / System Administrator"
/>
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteOgImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta
    property="og:image:alt"
    content="Patryk Polak — IT Support Specialist & Junior Linux / System Administrator"
/>
<meta property="og:image:secure_url" content={absoluteOgImage} />
<meta property="og:image:type" content="image/png" />

<!-- Twitter / X Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteOgImage} />

<!-- Dane strukturalne JSON-LD -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<script
    is:inline
    defer
    src="https://umami.inogi.pl/script.js"
    data-website-id={umamiWebsiteId}></script>
