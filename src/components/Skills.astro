---

<section id="kompetencje">
    <div class="skills-wrapper">
        <div class="section-header">
            <div class="header-titles">
                <p class="chapter">01&ensp;/&ensp;KOMPETENCJE</p>
                <h2>Trzy filary. Jeden standard pracy.</h2>
                <p class="subtitle">
                    Stabilność lwa. Zwinność kozła. Czujność węża. W praktyce —
                    solidne IT.
                </p>
            </div>
        </div>

        <div class="skills-container">
            <Skill
                icon={serverIcon}
                skill_count="01 / STABILNOŚĆ"
                title="Systemy i infrastruktura"
                paragraph="Instalacja, konfiguracja i utrzymanie Linux oraz Windows. Serwery VPS, konteneryzacja i wirtualizacja — od pierwszego wdrożenia po codzienną administrację."
                tags={["Linux", "Windows", "Docker", "VPS"]}
                summary="Fundament, na którym można polegać"
            />
            <Skill
                icon={networkIcon}
                skill_count="02 / ZWINNOŚĆ"
                title="IT Support i sieci"
                paragraph="Diagnostyka sprzętu i oprogramowania L1/L2/L3. TCP/IP, DNS, VPN i wsparcie użytkowników. Szukam przyczyny, nie tylko obejścia. Tłumaczę technologię prostym językiem."
                tags={["Troubleshooting", "TCP/IP", "DNS", "VPN"]}
                summary="Problem → diagnoza → rozwiązanie"
            />
            <Skill
                icon={securityIcon}
                skill_count="03 / CZUJNOŚĆ"
                title="Bezpieczeństwo i monitoring"
                paragraph="Hardening, Zero Trust, Firewall i WAF. Klucze FIDO2/SSH, automatyczne kopie S3/R2 oraz monitoring 24/7. Wykrywanie problemów, zanim zauważą je użytkownicy."
                tags={["Hardening", "Zero Trust", "Backup", "24/7"]}
                summary="Bezpieczeństwo to proces, nie checkbox"
            />
        </div>
    </div>
</section>

<style>
    section {
        width: 100%;
        min-width: 20rem; /* 320px */
        border-bottom: 2px solid #1a2638;
        padding-block: 3rem;
    }

    .skills-wrapper {
        width: 100%;
        max-width: 83.125rem; /* 1330px */
        margin-inline: auto;
        padding-inline: 1rem;
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .section-header {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        width: 100%;
    }

    .header-titles {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .chapter {
        color: #7cc6fe;
        font-size: var(--text-xs);
        font-family: var(--font-mono);
        line-height: 1.4;
        letter-spacing: 0.02em;
    }

    h2 {
        color: #eaf0f8;
    }

    .subtitle {
        color: #7f8fa5;
        line-height: 1.6;
        font-size: var(--text-lead);
    }

    .skills-container {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.25rem;
        width: 100%;
        align-items: stretch;
    }

    @media screen and (min-width: 768px) {
        section {
            padding-block: 4.5rem;
        }
        .skills-wrapper {
            padding-inline: 1.25rem;
            gap: 2.5rem;
        }
        .skills-container {
            grid-template-columns: repeat(2, 1fr);
            gap: 1.5rem;
        }
    }

    @media screen and (min-width: 1024px) {
        .skills-container {
            grid-template-columns: repeat(3, 1fr);
        }
    }
</style>
