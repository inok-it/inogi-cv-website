const securityIcon = `<svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
<g clip-path="url(#clip0_18_574)">
<path d="M15 9.74997C15 13.5 12.375 15.375 9.255 16.4625C9.09162 16.5178 8.91415 16.5152 8.7525 16.455C5.625 15.375 3 13.5 3 9.74997V4.49997C3 4.30106 3.07902 4.11029 3.21967 3.96964C3.36032 3.82899 3.55109 3.74997 3.75 3.74997C5.25 3.74997 7.125 2.84997 8.43 1.70997C8.58889 1.57422 8.79102 1.49963 9 1.49963C9.20898 1.49963 9.41111 1.57422 9.57 1.70997C10.8825 2.85747 12.75 3.74997 14.25 3.74997C14.4489 3.74997 14.6397 3.82899 14.7803 3.96964C14.921 4.11029 15 4.30106 15 4.49997V9.74997Z" stroke-width="1.275" stroke-linecap="round" stroke-linejoin="round" stroke="#7CC6FE"/>
</g>
<defs>
<clipPath id="clip0_18_574">
<rect width="18" height="18" fill="white"/>
</clipPath>
</defs>
</svg>
`;
const bashIcon = `<svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M3 12.75L7.5 8.25L3 3.75" stroke-width="1.275" stroke-linecap="round" stroke-linejoin="round" stroke="#7CC6FE"/>
<path d="M9 14.25H15" stroke-width="1.275" stroke-linecap="round" stroke-linejoin="round" stroke="#7CC6FE"/>
</svg>
`;
---

<section>
    <p class="chapter">03&ensp;/&ensp;TECH&ensp;STACK</p>
    <h2>Narzędzia dobrane do zadania.</h2>
    <p>Nie zbieram technologii. Wykorzystuję je do rozwiązywania problemów.</p>
    <div class="stack-container">
        <Stack
            icon={pcIcon}
            title="Systemy operacyjne"
            tags={[
                "Ubuntu Server",
                "Debian",
                "Fedora",
                "Arch / Manjaro",
                "Windows 10/11",
                "Windows Server",
            ]}
        />
        <Stack
            icon={networkIcon}
            title="Sieci i kontenery"
            tags={[
                "Docker / Compose",
                "Traefik",
                "Nginx / Apache",
                "VPN / SSH",
                "Cloudflare DNS / WAF",
                "Zero Trust",
            ]}
        />
        <Stack
            icon={securityIcon}
            title="Bezpieczeństwo i utrzymanie"
            tags={[
                "UFW / iptables",
                "Fail2ban",
                "Lynis",
                "Authentik",
                "YubiKey / FIDO2",
                "Uptime Kuma",
                "Dozzle / ntfy",
            ]}
        />
        <Stack
            icon={bashIcon}
            title="Skrypty i narzędzia"
            tags={[
                "Bash",
                "Git / GitHub",
                "Diagnostyka PC",
                "MariaDB / MySQL",
                "Redis",
                "AD / Microsoft 365 · podstawy",
            ]}
        />
    </div>
</section>

<style>
    section {
        width: 100%;
        max-width: 84rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        align-items: flex-start;
        justify-content: center;
        padding: 1.25rem;
        margin-inline: auto;
        border-bottom: 2px solid #1a2638;
    }

    .chapter {
        color: #7cc6fe;
        font-size: 12px;
    }
    h2 {
        color: #eaf0f8;
        line-height: 36px;
        letter-spacing: -1px;
    }
    p:last-of-type {
        color: #7f8fa5;
        line-height: 22px;
    }
    .stack-container {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        width: 100%;
        justify-content: center;
        gap: 1rem;
    }
</style>
