---

<section id="stack">
    <div class="techstack-wrapper">
        <div class="section-header">
            <div class="header-titles">
                <p class="chapter">03&ensp;/&ensp;TECH&ensp;STACK</p>
                <h2>Narzędzia dobrane do zadania.</h2>
                <p class="subtitle">
                    Nie zbieram technologii. Wykorzystuję je do rozwiązywania
                    problemów.
                </p>
            </div>
        </div>

        <div class="stack-container">
            <Stack
                icon={pcIcon}
                title="Systemy operacyjne"
                tags={[
                    "Ubuntu Server",
                    "Debian",
                    "Fedora",
                    "Arch / Manjaro",
                    "Windows 10/11",
                    "Windows Server",
                ]}
            />
            <Stack
                icon={networkIcon}
                title="Sieci i kontenery"
                tags={[
                    "Docker / Compose",
                    "Traefik",
                    "Nginx / Apache",
                    "VPN / SSH",
                    "Cloudflare DNS / WAF",
                    "Zero Trust",
                ]}
            />
            <Stack
                icon={securityIcon}
                title="Bezpieczeństwo i utrzymanie"
                tags={[
                    "UFW / iptables",
                    "Fail2ban",
                    "Lynis",
                    "Authentik",
                    "YubiKey / FIDO2",
                    "Uptime Kuma",
                    "Dozzle / ntfy",
                ]}
            />
            <Stack
                icon={bashIcon}
                title="Skrypty i narzędzia"
                tags={[
                    "Bash",
                    "Git / GitHub",
                    "Diagnostyka PC",
                    "MariaDB / MySQL",
                    "Redis",
                    "AD / Microsoft 365",
                ]}
            />
        </div>
    </div>
</section>

<style>
    section {
        /* Pełna szerokość (100%), aby dolna linia (border-bottom) rozciągała się na całą szerokość ekranu powyżej 1330px */
        width: 100%;
        min-width: 20rem; /* 320px */
        border-bottom: 2px solid #1a2638;
        padding-block: 3rem;
    }

    .techstack-wrapper {
        /* Wewnętrzny kontener ograniczający treść do 1330px (83.125rem) i centrujący ją na większych ekranach */
        width: 100%;
        max-width: 83.125rem; /* 1330px */
        margin-inline: auto;
        padding-inline: 1rem;
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .section-header {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        width: 100%;
    }

    .header-titles {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .chapter {
        color: #7cc6fe;
        font-size: var(--text-xs);
        font-family: var(--font-mono);
        line-height: 1.4;
        letter-spacing: 0.02em;
    }

    h2 {
        color: #eaf0f8;
    }

    .subtitle {
        color: #7f8fa5;
        line-height: 1.6;
        font-size: var(--text-lead);
    }

    .stack-container {
        /* Zamiast flexboxa z justify-content: center (który zostawiał wąskie karty na środku i dziury po bokach) używamy CSS Grid:
           - Mobile (320px+): 1 kolumna na 100% szerokości (jak na makiecie mobile)
           - Tablet (640px+): siatka 2x2
           - PC (1024px+): 4 równe kolumny w jednym rzędzie (jak na makiecie PC) */
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.25rem;
        width: 100%;
        align-items: stretch;
    }

    @media screen and (min-width: 640px) {
        .stack-container {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media screen and (min-width: 768px) {
        section {
            padding-block: 4.5rem;
        }
        .techstack-wrapper {
            padding-inline: 1.25rem;
            gap: 2.5rem;
        }
        .stack-container {
            gap: 1.5rem;
        }
    }

    @media screen and (min-width: 1024px) {
        .stack-container {
            grid-template-columns: repeat(4, 1fr);
        }
    }
</style>
