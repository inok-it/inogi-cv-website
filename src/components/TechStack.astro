<path d="M3 2.25H15C15.8284 2.25 16.5 2.92157 16.5 3.75V11.25C16.5 12.0784 15.8284 12.75 15 12.75H3C2.17157 12.75 1.5 12.0784 1.5 11.25V3.75C1.5 2.92157 2.17157 2.25 3 2.25Z" stroke-width="1.275" stroke-linecap="round" stroke-linejoin="round" stroke="#7CC6FE"/>
<path d="M6 15.75H12" stroke-width="1.275" stroke-linecap="round" stroke-linejoin="round" stroke="#7CC6FE"/>
<path d="M9 12.75V15.75" stroke-width="1.275" stroke-linecap="round" stroke-linejoin="round" stroke="#7CC6FE"/>
</svg>
`;
const networkIcon = `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M14.1667 13.3333H17.5C17.9603 13.3333 18.3334 13.7063 18.3334 14.1666V17.4999C18.3334 17.9602 17.9603 18.3333 17.5 18.3333H14.1667C13.7065 18.3333 13.3334 17.9602 13.3334 17.4999V14.1666C13.3334 13.7063 13.7065 13.3333 14.1667 13.3333Z" stroke-width="1.41667" stroke-linecap="round" stroke-linejoin="round" stroke="#7CC6FE"/>
<path d="M2.49996 13.3333H5.83329C6.29353 13.3333 6.66663 13.7063 6.66663 14.1666V17.4999C6.66663 17.9602 6.29353 18.3333 5.83329 18.3333H2.49996C2.03972 18.3333 1.66663 17.9602 1.66663 17.4999V14.1666C1.66663 13.7063 2.03972 13.3333 2.49996 13.3333Z" stroke-width="1.41667" stroke-linecap="round" stroke-linejoin="round" stroke="#7CC6FE"/>
