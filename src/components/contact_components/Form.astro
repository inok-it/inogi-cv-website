---
const currentPath = Astro.url.pathname;
const lang: "pl" | "en" = currentPath.startsWith("/en") ? "en" : "pl";

const content = {
    pl: {
        heading: "Zacznijmy od wiadomości",
        nameLabel: "Imię i nazwisko / Firma",
        namePlaceholder: "Jan Kowal / Twoja firma",
        emailLabel: "Twój adres e-mail",
        emailPlaceholder: "jan@firma.pl",
        textLabel: "Treść wiadomości (np. rola, lokalizacja, termin rozmowy)",
        textPlaceholder: "Cześć! Szukamy osoby, która...",
        submitBtn: "Wyślij wiadomość",
        umamiEvent: "Formularz - Wyślij wiadomość",
    },
    en: {
        heading: "Let's start with a message",
        nameLabel: "Name and surname / Company",
        namePlaceholder: "John Doe / Your company",
        emailLabel: "Your email address",
        emailPlaceholder: "john@company.com",
        textLabel: "Message body (e.g. role, location, interview date)",
        textPlaceholder: "Hi! We are looking for someone who...",
        submitBtn: "Send message",
        umamiEvent: "Form - Send message",
    },
};

const t = content[lang];
---

<form>
    <h3>{t.heading}</h3>

    <div class="inputs-grid">
        <div class="field">
            <label for="name">{t.nameLabel}</label>
            <input
                type="text"
                id="name"
                name="name"
                placeholder={t.namePlaceholder}
            />
        </div>
        <div class="field">
            <label for="email">{t.emailLabel}</label>
            <input
                type="email"
                id="email"
                name="email"
                placeholder={t.emailPlaceholder}
            />
        </div>
    </div>

    <div class="field">
        <label for="text">{t.textLabel}</label>
        <textarea name="text" id="text" rows="4" placeholder={t.textPlaceholder}
        ></textarea>
    </div>

    <button type="submit" data-umami-event={t.umamiEvent}>
        {t.submitBtn}
        <svg
            width="18"
            height="18"
            viewBox="0 0 18 18"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
        >
            <path
                d="M5.25 5.25H12.75V12.75"
                stroke-width="1.275"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke="#091522"></path>
            <path
                d="M5.25 12.75L12.75 5.25"
                stroke-width="1.275"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke="#091522"></path>
        </svg>
    </button>
</form>

<style>
    form {
        width: 100%;
        padding: 1.5rem 1.25rem;
        background-color: #101a2a;
        border: 2px solid #26354b;

        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        gap: 1.25rem;
        border-radius: 10px;
    }

    h3 {
        color: #eaf0f8;
    }
    .inputs-grid {
        width: 100%;
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
    }

    .field {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
    }

    label {
        font-size: var(--text-xs);
        color: #a0afc3;
        line-height: 1.4;
        font-weight: 500;
    }

    input,
    textarea {
        border-radius: 10px;
        border: 2px solid #2a3a50;
        background-color: #0a1423;
        padding: 0.875rem 1rem;
        width: 100%;
        font-family: inherit;
        font-size: var(--text-base);
        line-height: 1.5;
        color: #eaf0f8;
        transition: border-color 0.2s ease;
    }

    input:focus,
    textarea:focus {
        outline: none;
        border-color: #7cc6fe;
    }

    ::placeholder {
        color: #8a9eb5;
        font-size: var(--text-sm);
        line-height: 1.5;
    }
    textarea {
        resize: vertical;
        min-height: 7.5rem;
    }

    button {
        width: 100%;
        padding: 1rem;
        color: #0a1423;
        border-radius: 10px;
        background-color: #7cc6fe;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        font-weight: 600;
        font-family: inherit;
        font-size: var(--text-base);
        line-height: 1;
        cursor: pointer;
        border: none;
        transition: transform 0.2s ease;
        > svg {
            width: 1.25rem;
            height: 1.25rem;
            flex-shrink: 0;
        }
    }
    button:hover {
        transform: translateY(-2px);
    }
    p {
        margin-inline: auto;
        width: fit-content;
        color: #94a7be;
        font-size: var(--text-xs);
        text-align: center;
        line-height: 1.4;
    }

    @media screen and (min-width: 480px) {
        .inputs-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media screen and (min-width: 768px) {
        form {
            padding: 2rem;
        }
    }
</style>

<script
    type="text/javascript"
    src="https://cdn.jsdelivr.net/npm/@emailjs/browser@5/dist/email.min.js"
></script>

<script type="text/javascript">
    (function () {
        emailjs.init({
            publicKey: "YOUR_PUBLIC_KEY",
            blockHeadless: true,
            blockList: {
                list: ["foo@emailjs.com", "bar@emailjs.com"],
                watchVariable: "userEmail",
            },
            limitRate: {
                id: "app",
                throttle: 10000,
            },
        });
    })();

    const templateParams = {
        name: "James",
        notes: "Check this out!",
    };

    try {
        await emailjs.sendForm(
            "YOUR_SERVICE_ID",
            "YOUR_TEMPLATE_ID",
            "#myForm",
        );

        console.log("Email sent successfully");
    } catch (error) {
        console.error("Error sending email - ", error.text);
    }
</script>

<script>
    const contactForm = document.querySelector<HTMLFormElement>(
        "#kontakt form, form",
    );

    if (contactForm) {
        contactForm.addEventListener("submit", (e) => {
            e.preventDefault();

            const formData = new FormData(contactForm);
            const name =
                (formData.get("name") as string)?.trim() || "Brak danych";
            const email =
                (formData.get("email") as string)?.trim() || "Brak adresu";
            const message = (formData.get("text") as string)?.trim() || "";

            const recipient = "kontakt@inogi.pl";
            const subject = encodeURIComponent(
                `Współpraca IT — wiadomość od: ${name}`,
            );
            const body = encodeURIComponent(
                `Imię / Firma: ${name}\nAdres e-mail: ${email}\n\nWiadomość:\n${message}`,
            );

            window.location.href = `mailto:${recipient}?subject=${subject}&body=${body}`;
        });
    }
</script>
