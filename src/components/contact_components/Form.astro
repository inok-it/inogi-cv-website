---
const currentPath = Astro.url.pathname;
const lang: "pl" | "en" = currentPath.startsWith("/en") ? "en" : "pl";

const content = {
    pl: {
        heading: "Zacznijmy od wiadomości",
        nameLabel: "Imię i nazwisko / Firma",
        namePlaceholder: "Jan Kowal / Twoja firma",
        emailLabel: "Twój adres e-mail",
        emailPlaceholder: "jan@firma.pl",
        textLabel: "Treść wiadomości (np. rola, lokalizacja, termin rozmowy)",
        textPlaceholder: "Cześć! Szukamy osoby, która...",
        submitBtn: "Wyślij wiadomość",
        sendingBtn: "Wysyłanie...",
        successMsg: "Wiadomość wysłana! Odezwę się wkrótce.",
        errorMsg: "Błąd wysyłania. Spróbuj ponownie lub napisz bezpośrednio.",
        statusDefault: "Odpisuję zazwyczaj w ciągu 24 godzin.",
        umamiEvent: "Formularz - Wyślij wiadomość",
    },
    en: {
        heading: "Let's start with a message",
        nameLabel: "Name and surname / Company",
        namePlaceholder: "John Doe / Your company",
        emailLabel: "Your email address",
        emailPlaceholder: "john@company.com",
        textLabel: "Message body (e.g. role, location, interview date)",
        textPlaceholder: "Hi! We are looking for someone who...",
        submitBtn: "Send message",
        sendingBtn: "Sending...",
        successMsg: "Message sent! I'll get back to you soon.",
        errorMsg: "Error sending. Try again or email me directly.",
        statusDefault: "I usually reply within 24 hours.",
        umamiEvent: "Form - Send message",
    },
};

const t = content[lang];
---

<form id="contact-form" data-lang={lang}>
    <h3>{t.heading}</h3>

    <div class="inputs-grid">
        <div class="field">
            <label for="name">{t.nameLabel}</label>
            <input
                type="text"
                id="name"
                name="name"
                required
                placeholder={t.namePlaceholder}
            />
        </div>
        <div class="field">
            <label for="email">{t.emailLabel}</label>
            <input
                type="email"
                id="email"
                name="email"
                required
                placeholder={t.emailPlaceholder}
            />
        </div>
    </div>

    <div class="field">
        <label for="message">{t.textLabel}</label>
        <textarea
            name="message"
            id="message"
            rows="4"
            required
            placeholder={t.textPlaceholder}></textarea>
    </div>

    <input type="hidden" name="title" value="Nowa wiadomość ze strony Inogi" />
    <input type="hidden" name="time" id="time-input" value="" />

    <button type="submit" id="submit-btn" data-umami-event={t.umamiEvent}>
        <span class="btn-text">{t.submitBtn}</span>
        <svg
            width="18"
            height="18"
            viewBox="0 0 18 18"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
        >
            <path
                d="M5.25 5.25H12.75V12.75"
                stroke-width="1.275"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke="#091522"></path>
            <path
                d="M5.25 12.75L12.75 5.25"
                stroke-width="1.275"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke="#091522"></path>
        </svg>
    </button>
    <div id="form-status" class="form-status" aria-live="polite">
        {t.statusDefault}
    </div>
</form>

<style>
    form {
        width: 100%;
        padding: 1.5rem 1.25rem;
        background-color: #101a2a;
        border: 2px solid #26354b;

        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        gap: 1.25rem;
        border-radius: 10px;
    }

    h3 {
        color: #eaf0f8;
    }
    .inputs-grid {
        width: 100%;
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
    }

    .field {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
    }

    label {
        font-size: var(--text-xs);
        color: #a0afc3;
        line-height: 1.4;
        font-weight: 500;
    }

    input,
    textarea {
        border-radius: 10px;
        border: 2px solid #2a3a50;
        background-color: #0a1423;
        padding: 0.875rem 1rem;
        width: 100%;
        font-family: inherit;
        font-size: var(--text-base);
        line-height: 1.5;
        color: #eaf0f8;
        transition: border-color 0.2s ease;
    }

    input:focus,
    textarea:focus {
        outline: none;
        border-color: #7cc6fe;
    }

    ::placeholder {
        color: #8a9eb5;
        font-size: var(--text-sm);
        line-height: 1.5;
    }
    textarea {
        resize: vertical;
        min-height: 7.5rem;
    }

    button {
        width: 100%;
        padding: 1rem;
        color: #0a1423;
        border-radius: 10px;
        background-color: #7cc6fe;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        font-weight: 600;
        font-family: inherit;
        font-size: var(--text-base);
        line-height: 1;
        cursor: pointer;
        border: none;
        transition:
            transform 0.2s ease,
            opacity 0.2s ease,
            background-color 0.2s ease;
        > svg {
            width: 1.25rem;
            height: 1.25rem;
            flex-shrink: 0;
            transition: transform 0.2s ease;
        }
    }

    button:hover:not(:disabled) {
        transform: translateY(-2px);
    }

    button:disabled {
        opacity: 0.7;
        cursor: not-allowed;
    }

    .form-status {
        width: 100%;
        font-size: var(--text-sm);
        font-weight: 500;
        text-align: center;
        min-height: 1.5rem;
        color: #a0afc3;
    }

    .status-success {
        color: #4ade80; /* Zielony dla sukcesu */
    }

    .status-error {
        color: #f87171; /* Czerwony dla błędu */
    }

    p {
        margin-inline: auto;
        width: fit-content;
        color: #94a7be;
        font-size: var(--text-xs);
        text-align: center;
        line-height: 1.4;
    }

    @media screen and (min-width: 480px) {
        .inputs-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media screen and (min-width: 768px) {
        form {
            padding: 2rem;
        }
    }
</style>

<script>
    import emailjs from "@emailjs/browser";

    // Konfiguracja Email.js - uzupełnij swoimi danymi z dashboardu Email.js
    const PUBLIC_KEY = "ZXkiOxaInJT-9l3Up";
    const SERVICE_ID = "service_j6p2cpw";
    const TEMPLATE_ID = "template_oz96g4w";

    // Inicjalizacja biblioteki
    emailjs.init({
        publicKey: PUBLIC_KEY,
        limitRate: {
            id: "contact-form",
            throttle: 10000, // Limit wysyłania (10 sekund pomiędzy wysłaniami)
        },
    });

    const contactForm =
        document.querySelector<HTMLFormElement>("#contact-form");
    const submitBtn = document.querySelector<HTMLButtonElement>("#submit-btn");
    const btnText = submitBtn?.querySelector(".btn-text");
    const statusDiv = document.querySelector<HTMLDivElement>("#form-status");

    const messages = {
        pl: {
            sending: "Wysyłanie...",
            default: "Wyślij wiadomość",
            success: "Wiadomość wysłana! Odezwę się wkrótce.",
            error: "Błąd wysyłania. Spróbuj ponownie lub napisz bezpośrednio.",
            statusDefault: "Odpisuję zazwyczaj w ciągu 24 godzin.",
        },
        en: {
            sending: "Sending...",
            default: "Send message",
            success: "Message sent! I'll get back to you soon.",
            error: "Error sending. Try again or email me directly.",
            statusDefault: "I usually reply within 24 hours.",
        },
    };

    if (contactForm && submitBtn && btnText && statusDiv) {
        contactForm.addEventListener("submit", async (e) => {
            e.preventDefault();

            // Pobranie języka z atrybutu formularza
            const timeInput =
                contactForm.querySelector<HTMLInputElement>("#time-input");
            if (timeInput) {
                timeInput.value = new Date().toLocaleString("pl-PL");
            }

            const lang =
                (contactForm.getAttribute("data-lang") as "pl" | "en") || "pl";
            const t = messages[lang];

            // Czyszczenie poprzednich statusów
            statusDiv.textContent = "";
            statusDiv.className = "form-status";

            // Stan ładowania
            submitBtn.disabled = true;
            btnText.textContent = t.sending;

            try {
                await emailjs.sendForm(SERVICE_ID, TEMPLATE_ID, contactForm);

                // Sukces
                statusDiv.textContent = t.success;
                statusDiv.classList.add("status-success");
                contactForm.reset();
            } catch (error) {
                // Błąd
                console.error("Error sending email:", error);
                statusDiv.textContent = t.error;
                statusDiv.classList.add("status-error");
            } finally {
                // Przywrócenie przycisku
                submitBtn.disabled = false;
                btnText.textContent = t.default;

                setTimeout(() => {
                    statusDiv.textContent = t.statusDefault;
                    statusDiv.className = "form-status";
                }, 5000);
            }
        });
    }
</script>
