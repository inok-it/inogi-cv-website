---

---

<form>
    <h3>Zacznijmy od wiadomości</h3>

    <div>
        <label for="name">Imię / Firma</label>
        <input
            type="text"
            id="name"
            name="name"
            placeholder="Jan / Twoja firma"
        />
        <label for="email">Adres e-mail</label>
        <input
            type="email"
            id="email"
            name="email"
            placeholder="jan@firma.pl"
        />
    </div>
    <label for="text">Wiadomość / Link do oferty</label>
    <textarea name="text" id="text" placeholder="Cześć! Szukamy osoby, która..."
    ></textarea>
    <button type="submit"
        >Przygotuj wiadomość <svg
            width="18"
            height="18"
            viewBox="0 0 18 18"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
        >
            <path
                d="M5.25 5.25H12.75V12.75"
                stroke-width="1.275"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke="#091522"></path>
            <path
                d="M5.25 12.75L12.75 5.25"
                stroke-width="1.275"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke="#091522"></path>
        </svg>
    </button>
    <p>
        Formularz otwiera Twój program pocztowy. Dane nie są zapisywane na
        stronie.
    </p>
</form>

<style>
    form {
        padding: 2rem 1.25rem;
        background-color: #101a2a;
        border: 2px solid #26354b;

        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        gap: 1rem;
        border-radius: 10px;
    }

    h3 {
        color: #eaf0f8;
    }
    div {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-start;
        gap: 1rem;
    }
    label {
        font-size: var(--text-xs);
        color: #a0afc3;
        line-height: 1.4;
        font-weight: 500;
    }
    input {
        border-radius: 10px;
        border: 2px solid #2a3a50;
        background-color: #0a1423;
        padding: 1rem;
        width: 100%;
        font-family: inherit;
        font-size: var(--text-base);
        line-height: 1.5;
        color: #eaf0f8;
    }
    ::placeholder {
        color: #556a84;
        font-size: var(--text-sm);
        line-height: 1.5;
    }
    textarea {
        resize: none;
        border-radius: 10px;
        border: 2px solid #2a3a50;
        background-color: #0a1423;
        width: 100%;
        padding: 1rem;
    }

    button {
        width: 100%;
        padding: 1rem;
        color: #0a1423;
        border-radius: 10px;
        background-color: #7cc6fe;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        font-weight: 600;
        font-family: inherit;
        font-size: var(--text-base);
        line-height: 1;
        cursor: pointer;
        border: none;
        > svg {
            width: 1.25rem;
            height: 1.25rem;
        }
    }
    p {
        margin-inline: auto;
        width: fit-content;
        color: #60748f;
        font-size: var(--text-xs);
        text-align: center;
        line-height: 1.4;
    }
</style>
