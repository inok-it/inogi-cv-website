---
interface Props {
    header: string;
    title: string;
    text: string;
    tags: string;
}

const { header, title, text, tags } = Astro.props;
---

<div class="exp-item">
    <p class="exp-header">{header}</p>
    <h3>{title}</h3>
    <p class="exp-tags">{tags}</p>
    <p class="exp-text">{text}</p>
    <span class="exp-circle"></span>
</div>

<style>
    .exp-item {
        position: relative;
        width: 100%;
        display: flex;
        flex-direction: column;
        flex-wrap: nowrap;
        align-items: flex-start;
        justify-content: flex-start;
        gap: 0.375rem;
    }
    .exp-circle {
        position: absolute;
        /* Idealne wycentrowanie punktu (szerokość 0.625rem / 10px) na linii border-left (2px):
           Dla padding-left: 1.25rem (20px) w .exp-content -> -1.25rem - 1px (połowa bordera) - 0.3125rem (połowa kółka) = -1.625rem */
        left: -1.625rem;
        top: 0.125rem;
        display: inline-block;
        width: 0.625rem;
        height: 0.625rem;
        border-radius: 50%;
        border: 2px solid #7cc6fe;
        background-color: #091020;
    }

    .exp-header {
        font-size: var(--text-xs);
        font-family: var(--font-mono);
        letter-spacing: 0.05em;
        line-height: 1.4;
        color: #7cc6fe;
    }

    h3 {
        color: #eaf0f8;
    }
    .exp-tags {
        font-size: var(--text-xs);
        line-height: 1.4;
        color: #72849d;
        margin-bottom: 0.25rem;
    }
    .exp-text {
        font-size: var(--text-card);
        line-height: 1.6;
        color: #92a0b4;
    }

    @media screen and (min-width: 768px) {
        .exp-circle {
            /* Dopasowanie pozycji kółka do padding-left: 1.75rem na tabletach */
            left: -2.125rem;
        }
    }

    @media screen and (min-width: 1024px) {
        .exp-circle {
            /* Dopasowanie pozycji kółka do padding-left: 2rem na PC */
            left: -2.375rem;
        }
    }
</style>
