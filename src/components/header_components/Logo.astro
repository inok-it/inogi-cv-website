---
import Image from "astro/components/Image.astro";
import LogoImg from "../../assets/Inogi_logo_DARK_BG.svg";
---

<div class="logo">
    <Image src={LogoImg} alt="Logo" class="logo-img" />
    <div class="logo-text">
        <span>INOGI</span>
        <span>IT SUPPORT & SYSADMIN</span>
    </div>
</div>

<style>
    .logo {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .logo-img {
        width: auto;
        height: 4rem;
    }
    .logo-text {
        display: flex;
        flex-direction: column;
        gap: 0.125rem;
    }
    .logo-text span:first-of-type {
        font-size: var(--text-h3);
        letter-spacing: 4px;
        font-weight: 700;
        color: #e8eef6;
        line-height: 1.1;
    }
    .logo-text span:last-of-type {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 400;
        letter-spacing: 2px;
        color: #8e9bae;
        line-height: 1.2;
    }
</style>
