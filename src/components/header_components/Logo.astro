---
import Image from "astro/components/Image.astro";
import LogoImg from "../../assets/Inogi_logo_DARK_BG.svg";

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith("/en") ? "en" : "pl";

const content = {
    pl: {
        ariaLabel: "INOGI — Strona główna",
        href: "#o-mnie",
    },
    en: {
        ariaLabel: "INOGI — Homepage",
        href: "#about-me",
    },
};

const t = content[lang];
---

<a href={t.href} class="logo" aria-label={t.ariaLabel}>
    <div class="logo">
        <Image src={LogoImg} alt="" class="logo-img" loading={"eager"} />
        <div class="logo-text">
            <span>PATRYK POLAK</span>
            <span>IT SUPPORT & JUNIOR SYSADMIN</span>
        </div>
    </div>
</a>

<style>
    a {
        text-decoration: none;
    }
    .logo {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-shrink: 1;
    }
    .logo-img {
        width: auto;
        height: clamp(3rem, 2.5rem + 2.5vw, 3.5rem);
    }
    .logo-text {
        display: flex;
        flex-direction: column;
        gap: 0.125rem;
    }
    .logo-text span:first-of-type {
        font-size: var(--text-h3);
        letter-spacing: clamp(2px, 0.5vw, 4px);
        font-weight: 700;
        color: #e8eef6;
        line-height: 1.1;
    }
    .logo-text span:last-of-type {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 400;
        letter-spacing: clamp(0.5px, 0.25vw, 2px);
        color: #8e9bae;
        line-height: 1.2;

        white-space: normal;
        word-break: break-word;
    }

    @media screen and (min-width: 1020px) {
        .logo {
            flex-shrink: 0;
        }
    }
</style>
