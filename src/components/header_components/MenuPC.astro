---
const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith("/en") ? "en" : "pl";

const content = {
    pl: {
        navAria: "Główna nawigacja",
        items: [
            { label: "Kompetencje", id: "kompetencje" },
            { label: "Homelab & Projekty", id: "homelab" },
            { label: "Stack", id: "stack" },
            { label: "Doświadczenie", id: "doswiadczenie" },
            { label: "Kontakt", id: "kontakt" },
        ],
    },
    en: {
        navAria: "Main navigation",
        items: [
            { label: "Skills", id: "skills" },
            { label: "Homelab & Projects", id: "homelab" },
            { label: "Stack", id: "stack" },
            { label: "Experience", id: "experience" },
            { label: "Contact", id: "contact" },
        ],
    },
};

const t = content[lang];
---

<nav aria-label={t.navAria} class="nav-pc">
    <ul class="menu-pc">
        {
            t.items.map((item) => (
                <li>
                    <a href={`#${item.id}`} data-section={item.id}>
                        {item.label}
                    </a>
                </li>
            ))
        }
    </ul>
</nav>

<style>
    .nav-pc {
        display: none;
    }
    .menu-pc {
        display: none;
        width: auto;
        list-style: none;
        margin: 0;
        padding: 0;
        font-size: var(--text-card);
        gap: clamp(1rem, 2vw, 2rem);
        height: 3rem;
    }
    .menu-pc li {
        display: block;
        cursor: pointer;
        height: 100%;
        text-align: center;
    }
    .menu-pc a {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        text-decoration: none;
        color: #a7b3c5;
        white-space: nowrap;
        transition: color 0.2s ease-in-out;
        font-weight: 500;
    }

    .menu-pc > li > a:hover,
    .menu-pc > li > a.active {
        color: #7cc6fe;
    }

    .menu-pc > li > a::after {
        content: "";
        position: absolute;
        bottom: 0.375rem;
        left: 0;
        width: 100%;
        height: 2px;
        background-color: #7cc6fe;
        border-radius: 2px;
        transform: scaleX(0);
        transition: transform 0.25s ease;
    }

    .menu-pc > li > a.active::after {
        transform: scaleX(1);
    }

    @media screen and (min-width: 1200px) {
        .menu-pc {
            display: flex;
        }
    }
    @media screen and (min-width: 1200px) {
        .nav-pc {
            display: block;
        }
    }
</style>
<script>
    const navLinks = document.querySelectorAll<HTMLAnchorElement>(
        ".menu-pc a[data-section]",
    );
    const sections = document.querySelectorAll<HTMLElement>("section[id]");
    const observerOptions = {
        root: null,
        rootMargin: "-35% 0px -55% 0px",
        threshold: 0,
    };
    const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) {
                const activeId = entry.target.getAttribute("id");
                navLinks.forEach((link) => {
                    link.classList.toggle(
                        "active",
                        link.getAttribute("data-section") === activeId,
                    );
                });
            }
        });
    }, observerOptions);

    sections.forEach((section) => observer.observe(section));
</script>
