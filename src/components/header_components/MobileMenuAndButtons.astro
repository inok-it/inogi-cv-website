---

<div class="button-wrapper">
    <button
        type="button"
        class="download-btn hide-download-btn-less-than-500px"
        data-umami-event="Header - Pobierz CV"
        data-download-cv
    >
        <svg
            width="13"
            height="18"
            viewBox="0 0 13 18"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
        >
            <path
                d="M11.375 10.625V12.7917C11.375 13.079 11.2609 13.3545 11.0577 13.5577C10.8545 13.7609 10.579 13.875 10.2917 13.875H2.70833C2.42102 13.875 2.14547 13.7609 1.9423 13.5577C1.73914 13.3545 1.625 13.079 1.625 12.7917V10.625"
                stroke-width="0.920833"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke="#E8EEF6"></path>
            <path
                d="M3.79167 7.91675L6.5 10.6251L9.20833 7.91675"
                stroke-width="0.920833"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke="#E8EEF6"></path>
            <path
                d="M6.5 10.625V4.125"
                stroke-width="0.920833"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke="#E8EEF6"></path>
        </svg> Pobierz CV
    </button>
    <button
        type="button"
        aria-label="Otwórz menu nawigacji"
        aria-expanded="false"
        aria-controls="mobile-nav-list"
        class="menu-btn"
    >
        <span class="sr-only">Otwórz menu nawigacji</span>
        <svg
            aria-hidden="true"
            focusable="false"
            width="13"
            height="18"
            viewBox="0 0 13 18"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
        >
            <path
                d="M2.16667 9H10.8333"
                stroke-width="0.920833"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke="#e8eef6"></path>
            <path
                d="M2.16667 5.75H10.8333"
                stroke-width="0.920833"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke="#e8eef6"></path>
            <path
                d="M2.16667 12.25H10.8333"
                stroke-width="0.920833"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke="#e8eef6"></path>
        </svg>
    </button>
</div>

<nav aria-label="Główna nawigacja" class="mobile-nav-wrapper">
    <ul id="mobile-nav-list" class="menu-mobile">
        <li><a href="#kompetencje">Kompetencje</a></li>
        <li>
            <a href="#homelab">Homelab & Projekty</a>
        </li>
        <li><a href="#stack">Stack technologiczny</a></li>
        <li><a href="#doswiadczenie">Doświadczenie</a></li>
        <li><a href="#kontakt">Kontakt</a></li>
        <li>
            <button
                type="button"
                data-download-cv
                class="download-btn hide-download-btn-more-than-500px"
                data-umami-event="Mobile Menu - Pobierz CV"
            >
                <svg
                    aria-hidden="true"
                    width="13"
                    height="18"
                    viewBox="0 0 13 18"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                >
                    <path
                        d="M11.375 10.625V12.7917C11.375 13.079 11.2609 13.3545 11.0577 13.5577C10.8545 13.7609 10.579 13.875 10.2917 13.875H2.70833C2.42102 13.875 2.14547 13.7609 1.9423 13.5577C1.73914 13.3545 1.625 13.079 1.625 12.7917V10.625"
                        stroke-width="0.920833"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke="#E8EEF6"></path>
                    <path
                        d="M3.79167 7.91675L6.5 10.6251L9.20833 7.91675"
                        stroke-width="0.920833"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke="#E8EEF6"></path>
                    <path
                        d="M6.5 10.625V4.125"
                        stroke-width="0.920833"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke="#E8EEF6"></path>
                </svg>
                Pobierz CV
            </button>
        </li>
    </ul>
</nav>

<style>
    .mobile-nav-wrapper {
        display: contents;
    }

    .button-wrapper {
        display: flex;
        align-items: center;
        flex-shrink: 0;
        gap: 0.5rem;
    }

    .menu-btn {
        background: none;
        border: 2px solid #202c3e;
        cursor: pointer;
        border-radius: 10px;
        height: 3rem;
        width: 3rem;
        transition: all 0.2s ease;
    }
    .menu-btn svg {
        width: 100%;
        height: 100%;
    }

    .menu-mobile {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        width: 100%;
        list-style: none;
        margin: 0;
        padding: 0;
        border-top: 1px solid #202c3e;
        border-bottom: 2px solid #202c3e;
        background-image: linear-gradient(
            130deg,
            rgba(16, 28, 43, 0.85),
            rgba(13, 23, 38, 0.85)
        );
        background-color: #091020;
    }
    .menu-mobile li {
        margin-inline: 1.25rem;
        padding-block: 1.25rem;
        cursor: pointer;
    }
    .menu-mobile li a {
        font-size: var(--text-base);
        text-decoration: none;
        color: #e8eef6;
        font-weight: 500;
    }
    .menu-mobile li:not(:last-of-type) {
        border-bottom: 2px solid #202c3e;
    }

    .download-btn {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        height: 3rem;
        background: none;
        border: 2px solid #202c3e;
        cursor: pointer;
        border-radius: 10px;
        padding: 0.5rem 0.75rem;
        font-weight: 500;
        margin-bottom: 1rem;
        margin-inline: auto;
        color: #e8eef6;
        font-size: var(--text-base);
        white-space: nowrap;
        transition: all 0.2s ease;
        font-family: inherit;
        line-height: 1;
    }
    .download-btn svg {
        width: 1.5rem;
        height: 1.5rem;
        flex-shrink: 0;
    }

    .download-btn:hover,
    .menu-btn:hover {
        transform: translateY(-2px);
        border-color: #7cc6fe;
        background-color: rgba(124, 198, 254, 0.1);
    }

    .show-menu {
        display: block;
    }

    @media screen and (min-width: 500px) {
        /* Ważne: w izolowanych stylach Astro, jeśli nadpisujesz klasy dodane w HTML, musisz czasem użyć :global, ale zacznijmy od Twojego oryginału */
        .hide-download-btn-more-than-500px {
            display: none !important;
        }
        .download-btn {
            margin-bottom: 0;
            margin-inline: 0;
        }

        .menu-mobile > li:last-of-type {
            display: none;
        }

        .menu-mobile > li:nth-last-of-type(2) {
            border-bottom: none;
        }
    }
    @media screen and (max-width: 500px) {
        .hide-download-btn-less-than-500px {
            display: none !important;
        }
    }

    @media screen and (min-width: 768px) {
        .button-wrapper {
            gap: 1rem;
        }
        .menu-btn,
        .download-btn {
            height: 3rem;
        }
        .menu-btn {
            width: 3rem;
        }
    }

    @media screen and (min-width: 1024px) {
        .menu-btn {
            display: none;
        }
        .menu-mobile {
            display: none !important;
        }
    }

    .menu-mobile > li > .download-btn {
        width: 100%;
        margin-bottom: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }
</style>

<script>
    const menuBtn = document.querySelector(".menu-btn");
    const menu = document.querySelector(".menu-mobile");

    if (menuBtn && menu) {
        menuBtn.addEventListener("click", () => {
            const isOpen = menu.classList.toggle("show-menu");
            menuBtn.setAttribute("aria-expanded", String(isOpen));
        });

        menu.querySelectorAll("a").forEach((link) => {
            link.addEventListener("click", () => {
                menu.classList.remove("show-menu");
                menuBtn.setAttribute("aria-expanded", "false");
            });
        });
    }
</script>
