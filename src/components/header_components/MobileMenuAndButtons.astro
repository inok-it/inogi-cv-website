<style>
    .button-wrapper {
        display: flex;
        gap: 1rem;
    }

    .menu-btn {
        background: none;
        border: 2px solid var(--border-color);
        cursor: pointer;
        border-radius: 10px;
        height: 3rem;
        width: 3rem;
        transition: all 0.2s ease;
    }
    .menu-btn svg {
        width: 100%;
        height: 100%;
    }

    .menu-mobile {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        width: inherit; /* Astro może wymagać 100% tu w izolowanych stylach zamiast inherit, jeśli header nie będzie bezpośrednim rodzicem z widocznym width */
        list-style: none;
        margin: 0;
        padding: 0;
        border-top: 1px solid var(--border-color);
        border-bottom: 2px solid var(--border-color);
        background-image: var(--gradient-secondary);
        background-color: var(--color-primary);
    }
    .menu-mobile li {
        margin-inline: 1.25rem;
        padding-block: 1.25rem;
        cursor: pointer;
    }
    .menu-mobile li a {
        text-decoration: none;
        color: var(--text-color-primary);
    }
    .menu-mobile li:not(:last-of-type) {
        border-bottom: 2px solid var(--border-color);
    }

    .download-btn {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        height: 3rem;
        background: none;
        border: 2px solid var(--border-color);
        cursor: pointer;
        border-radius: 10px;
        padding: 0.5rem 0.75rem;
        font-weight: 500;
        margin-bottom: 1rem;
        margin-inline: auto;
        color: var(--text-color-primary);
        font-size: 0.875rem;
        white-space: nowrap;
        transition: all 0.2s ease;
    }
    .download-btn svg {
        width: 1.5rem;
        height: 1.5rem;
    }
    .download-btn span {
        font-size: 0.75rem;
        color: var(--text-color-secondary);
    }

    .download-btn:hover,
    .menu-btn:hover {
        transform: translateY(-2px);
        border-color: var(--accent-color);
        background-color: var(--accent-color-transparent);
    }

    .show-menu {
        display: block;
    }

    @media screen and (min-width: 500px) {
        /* Ważne: w izolowanych stylach Astro, jeśli nadpisujesz klasy dodane w HTML, musisz czasem użyć :global, ale zacznijmy od Twojego oryginału */
        .hide-download-btn-more-than-500px {
            display: none !important;
        }
        .download-btn {
            margin-bottom: 0;
            margin-inline: 0;
        }
    }
    @media screen and (max-width: 500px) {
        .hide-download-btn-less-than-500px {
            display: none !important;
        }
    }
    @media screen and (min-width: 1024px) {
        .menu-btn {
            display: none;
        }
    }
</style>

<script>
    const menuBtn = document.querySelector(".menu-btn");
    const menu = document.querySelector(".menu-mobile");
    if (menuBtn && menu) {
        menuBtn.addEventListener("click", () => {
            menu.classList.toggle("show-menu");
        });
    }
</script>
