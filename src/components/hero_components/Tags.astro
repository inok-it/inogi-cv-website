---
const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith("/en") ? "en" : "pl";

const content = {
    pl: {
        text: "✓ Inż. Informatyki · ✓ 100% dyspozycyjności · ✓ Linux, Windows/AD, Sieci i ERP",
    },
    en: {
        text: "✓ B.Eng. in Computer Science · ✓ 100% availability · ✓ Linux, Windows/AD, Networks & ERP",
    },
};

const t = content[lang];
---

<p class="tags">
    {t.text}
</p>

<style>
    p {
        display: inline-flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.375rem;
        color: #7e8ca1;
        font-size: var(--text-xs);
        font-family: var(--font-mono);
        line-height: 1.4;
    }

    svg {
        flex-shrink: 0;
    }
</style>
