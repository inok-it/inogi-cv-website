---
import ProofHeader from "./ProofHeader.astro";

interface Props {
    headerTags: string[];
    title: string;
    newLineTitle: string;
    challenge: string;
    solution: string;
    tags: string[];

    headerType: "no-code" | "code";
    statusTag: string;
    lab: string;
    iconSet: 1 | 2 | null;
    githubUrl?: string;
    githubLabel?: string;
}

const currentPath = Astro.url.pathname;
const lang: "pl" | "en" = currentPath.startsWith("/en") ? "en" : "pl";

const content = {
    pl: {
        challengeLabel: "Wyzwanie: ",
        solutionLabel: "Rozwiązanie: ",
        defaultGithubLabel: "Zobacz Runbooki i kod na GitHub ->",
    },
    en: {
        challengeLabel: "Challenge: ",
        solutionLabel: "Solution: ",
        defaultGithubLabel: "View Runbooks and code on GitHub ->",
    },
};

const t = content[lang];

const {
    headerTags,
    title,
    newLineTitle,
    challenge,
    solution,
    tags,
    headerType,
    statusTag,
    lab,
    iconSet,
    githubUrl,
    githubLabel = t.defaultGithubLabel,
} = Astro.props;
---

<article class="card-hover">
    <ProofHeader
        headerType={headerType}
        statusTag={statusTag}
        lab={lab}
        iconSet={iconSet}
    />
    <div class="proof-wraper">
        <p class="header-tags-homelab">
            {headerTags[0]}&ensp;·&ensp;{headerTags[1]}&ensp;·&ensp;{
                headerTags[2]
            }
        </p>
        <h3>{title}<br /> {newLineTitle}</h3>
        <p class="solution">
            <span class="bolder">{t.challengeLabel}</span>{challenge}<br />
            <span class="bolder">{t.solutionLabel}</span>{solution}
        </p>
        <ul class="tags-homelab">
            {tags.map((tag) => <li class="tag-homelab">{tag}</li>)}
        </ul>
        {
            githubUrl && (
                <a
                    href={githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="proof-github-link"
                >
                    {githubLabel}
                </a>
            )
        }
    </div>
</article>

<style>
    article {
        width: 100%;
        height: 100%;

        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: flex-start;

        background-color: #101c2b;
        border-radius: 10px;
        border: 2px solid #233044;
    }

    .proof-wraper {
        width: 100%;
        flex: 1;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: flex-start;
        gap: 0.75rem;
        border-top: 2px solid #28364a;
    }

    .header-tags-homelab {
        font-size: var(--text-xs);
        font-family: var(--font-mono);
        color: #8db4d2;
        letter-spacing: 1px;
        line-height: 1.4;
    }

    h3 {
        color: #eaf0f8;
        line-height: 1.25;
    }

    .solution {
        line-height: 1.45;
        color: #8b9bb0;
        font-size: var(--text-card);
    }

    .bolder {
        font-weight: 600;
        color: #c9d5e5;
    }

    .tags-homelab {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: flex-start;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-top: 0.25rem;
    }

    .tag-homelab {
        color: #99adc6;
        padding: 0.25rem 0.5rem;
        font-size: var(--text-xs);
        font-family: var(--font-mono);
        line-height: 1.4;
        letter-spacing: 0.02em;
        background-color: #142033;
        border: 2px solid #28364a;
        border-radius: 6px;
    }

    @media screen and (min-width: 768px) {
        .proof-wraper {
            padding: 1.25rem;
        }
    }

    .proof-github-link {
        display: inline-flex;
        align-items: center;
        margin-top: auto;
        font-family: monospace;
        font-size: 0.8rem;
        font-weight: 600;
        color: #7cc6fe;
        text-decoration: none;
        transition:
            color 0.2s ease,
            transform 0.2s ease;
    }

    .proof-github-link:hover,
    .proof-github-link:focus-visible {
        color: #bae0ff;
        transform: translateX(3px);
        text-decoration: underline;
    }
</style>
