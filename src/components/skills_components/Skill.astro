---
interface Props {
    icon: string;
    title: string;
    skill_count: string;
    paragraph: string;
    tags: string[];
    summary: string;
}

const { icon, title, skill_count, paragraph, tags, summary } = Astro.props;
---

<article class="card card-hover">
    <header class="card-header">
        <div class="icon-wrapper" set:html={icon} />
        <span class="skill-count">{skill_count}</span>
    </header>

    <h3>{title}</h3>

    <p class="description">{paragraph}</p>

    <ul class="tags">
        {tags.map((tag) => <li class="tag">{tag}</li>)}
    </ul>

    <footer class="summary">
        <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
        >
            <path
                d="M20 6L9 17l-5-5"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
        </svg>
        <span>{summary}</span>
    </footer>
</article>

<style>
    article {
        width: 100%;
        height: 100%;
        border-radius: 10px;
        border: 2px solid #233044;
        background-color: #101c2b;

        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: flex-start;

        gap: 0.75rem;
        padding: 1rem;
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        gap: 0.5rem;

        .icon-wrapper {
            background-color: #142a3d;
            border-radius: 8px;
            border: 2px solid #29435a;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            padding: 0.375rem;
        }

        .skill-count {
            color: #8e9fb5;
            font-size: var(--text-xs);
            font-family: var(--font-mono);
            line-height: 1.4;
            text-align: right;
        }
    }

    h3 {
        color: #eaf0f8;
        line-height: 1.25;
    }

    .description {
        color: #8b9bb0;
        line-height: 1.45;
        font-size: var(--text-card);
    }

    .tags {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: flex-start;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-top: auto;
        padding-top: 0.25rem;
    }

    .tag {
        color: #99adc6;
        padding: 0.25rem 0.5rem;
        background-color: #142033;
        border: 2px solid #28364a;
        border-radius: 6px;
        font-size: var(--text-xs, 0.75rem);
    }

    footer {
        width: 100%;
        padding-top: 0.75rem;
        color: #8db4d2;
        border-top: 1px solid #1c293b;
        font-size: var(--text-xs);
        display: flex;
        align-items: center;
        justify-content: flex-start;
        font-family: var(--font-mono);
        line-height: 1.4;
    }

    footer > svg {
        margin-right: 0.5rem;
        color: #6f91ab;
        flex-shrink: 0;
    }

    @media screen and (min-width: 768px) {
        article {
            padding: 1.25rem;
        }
    }
</style>
