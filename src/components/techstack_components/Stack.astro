---
interface Props {
    icon: string;
    title: string;
    tags: string[];
}

const { icon, title, tags } = Astro.props;
---

<div class="skill-stack">
    <div class="title-and-icon-wrapper">
        <div class="icon-wrapper" set:html={icon} />
        <h3>{title}</h3>
    </div>
    <ul class="tags">
        {tags.map((tag) => <li class="tag">{tag}</li>)}
    </ul>
</div>

<style>
    .skill-stack {
        width: 100%;
        height: 100%;
        border-radius: 10px;
        border: 2px solid #233044;
        background-color: #101c2b;

        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: flex-start;
        gap: 1rem;
        padding: 1.25rem;
    }
    .title-and-icon-wrapper {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 0.625rem;
    }
    .icon-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-shrink: 0;
    }

    h3 {
        line-height: 1.3;
        color: #d4deeb;
        font-size: var(--text-base);
    }

    .tags {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: flex-start;
        flex-wrap: wrap;
        gap: 0.5rem;
    }
    .tag {
        color: #99adc6;
        padding: 0.375rem 0.625rem;
        background-color: #142033;
        border: 2px solid #28364a;
        border-radius: 6px;
    }

    @media screen and (min-width: 768px) {
        .skill-stack {
            padding: 1.5rem;
        }
    }
</style>
