---
import Font from "astro/components/Font.astro";
import Seo from "../components/Seo.astro";

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith("/en") ? "en" : "pl";
---

<!doctype html>
<html lang={lang}>
	<head>
		<Seo />
		<Font
			cssVariable="--font-inter"
			preload={[{ weight: 400, style: "normal" }]}
		/>
		<Font cssVariable="--font-jetbrains-mono" />
	</head>
	<body>
		<slot />
	</body>
</html>
