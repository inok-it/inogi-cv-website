---
import Layout from "../layouts/Layout.astro";
import GlobalStyling from "../styles/GlobalStyling.astro";
import ResetStyling from "../styles/ResetStyling.astro";

const currentPath = Astro.url.pathname;
const lang: "pl" | "en" = currentPath.startsWith("/en") ? "en" : "pl";

const content = {
    pl: {
        title: "404 — Nie znaleziono strony | Patryk Polak",
        errorCode: "ERROR 404",
        heading: "Strona, której szukasz, nie istnieje.",
        description:
            "Wygląda na to, że wprowadzony adres jest błędny lub strona została przeniesiona. Wróć na stronę główną, aby zapoznać się z moją ofertą i projektami.",
        homeBtn: "Wróć na stronę główną",
    },
    en: {
        title: "404 — Page Not Found | Patryk Polak",
        errorCode: "ERROR 404",
        heading: "The page you are looking for doesn't exist.",
        description:
            "It looks like the URL is incorrect or the page has been moved. Return to the homepage to explore my projects and professional background.",
        homeBtn: "Back to homepage",
    },
};

const t = content[lang];
const homeUrl = lang === "en" ? "/en/" : "/";
---

<Layout title={t.title}>
    <ResetStyling />
    <GlobalStyling />
    <main class="not-found-main">
        <div class="not-found-container">
            <span class="error-code">{t.errorCode}</span>
            <h1>{t.heading}</h1>
            <p>{t.description}</p>
            <a
                href={homeUrl}
                class="home-btn"
                data-umami-event={`404 - ${t.homeBtn}`}
            >
                {t.homeBtn}
                <svg
                    width="18"
                    height="18"
                    viewBox="0 0 18 18"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                >
                    <path
                        d="M10.5 13.5L6 9L10.5 4.5"
                        stroke-width="1.275"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke="#091522"></path>
                </svg>
            </a>
        </div>
    </main>
</Layout>

<style>
    .not-found-main {
        min-height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        padding: 0rem 1.5rem;
        text-align: center;
        margin-block: auto;
    }

    .not-found-container {
        max-width: 38rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
    }

    .error-code {
        font-family: var(--font-jetbrains-mono, monospace);
        font-size: var(--text-xs);
        color: #7cc6fe;
        background-color: #0b1421;
        border: 2px solid #233446;
        padding: 0.35rem 0.85rem;
        border-radius: 6px;
        letter-spacing: 0.05em;
    }

    h1 {
        color: #e8eef6;
        font-size: clamp(1.75rem, 3vw, 2.5rem);
        line-height: 1.2;
    }

    p {
        color: #94a2b6;
        font-size: var(--text-lead, 1rem);
        line-height: 1.6;
    }

    .home-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        background-color: #7cc6fe;
        color: #091522;
        font-weight: 600;
        padding: 0.85rem 1.5rem;
        border-radius: 8px;
        text-decoration: none;
        margin-top: 0.5rem;
    }
</style>
