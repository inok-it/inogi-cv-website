---
import Header from "../../components/Header.astro";
import Layout from "../../layouts/Layout.astro";
import GlobalStyling from "../../styles/GlobalStyling.astro";
import ResetStyling from "../../styles/ResetStyling.astro";
import HeroSection from "../../components/HeroSection.astro";
import Skills from "../../components/Skills.astro";
import Footer from "../../components/Footer.astro";
import TechStack from "../../components/TechStack.astro";
import Experience from "../../components/Experience.astro";
import Contact from "../../components/Contact.astro";
import Homelab from "../../components/Homelab.astro";
---

<Layout>
	<ResetStyling />
	<GlobalStyling />
	<Header />
	<main>
		<HeroSection />
		<Skills />
		<Homelab />
		<TechStack />
		<Experience />
		<Contact />
	</main>
	<Footer />
</Layout>

<style>
	main {
		display: flex;
		flex-direction: column;
	}
</style>

<script>
	const initCvDownloadButtons = (): void => {
		const downloadButtons =
			document.querySelectorAll<HTMLButtonElement>("[data-download-cv]");
		if (!downloadButtons.length) return;

		const triggerDownload = (): void => {
			const dir = "ef";
			const partA = "c4c13a1c";
			const partB = "489e2f4e";

			const link = document.createElement("a");
			link.href = `/${dir}/${partA}${partB}`;
			link.download = "Patryk_Polak_CV.pdf";
			link.rel = "noindex, nofollow";

			document.body.appendChild(link);
			link.click();
			document.body.removeChild(link);
		};

		downloadButtons.forEach((button) => {
			button.addEventListener("click", triggerDownload);
		});
	};

	initCvDownloadButtons();
</script>
