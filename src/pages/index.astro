---
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
import GlobalStyling from "../styles/GlobalStyling.astro";
import ResetStyling from "../styles/ResetStyling.astro";
import HeroSection from "../components/HeroSection.astro";
import Skills from "../components/Skills.astro";
import Footer from "../components/Footer.astro";
import TechStack from "../components/TechStack.astro";
import Experience from "../components/Experience.astro";
import Contact from "../components/Contact.astro";
import Homelab from "../components/Homelab.astro";
---

<Layout>
	<ResetStyling />
	<GlobalStyling />
	<Header />
	<main>
		<HeroSection />
		<Skills />
		<Homelab />
		<TechStack />
		<Experience />
		<Contact />
	</main>
	<Footer />
</Layout>

<style>
	main {
		display: flex;
		flex-direction: column;
	}
</style>

<script>
	const initCvDownloadButtons = (): void => {
		const downloadButtons =
			document.querySelectorAll<HTMLButtonElement>("[data-download-cv]");
		if (!downloadButtons.length) return;

		const triggerDownload = (): void => {
			const dir = "bq";
			const partA = "7f7ab2c5";
			const partB = "c0e6c3d6";

			const link = document.createElement("a");
			link.href = `/${dir}/${partA}${partB}`;
			link.download = "Patryk_Polak_CV.pdf";
			link.rel = "noindex, nofollow";

			document.body.appendChild(link);
			link.click();
			document.body.removeChild(link);
		};

		downloadButtons.forEach((button) => {
			button.addEventListener("click", triggerDownload);
		});
	};

	initCvDownloadButtons();
</script>
