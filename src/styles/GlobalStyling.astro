<style is:global is:inline>
    :root {
        --font-sans: "Inter", system-ui, -apple-system, sans-serif;
        --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace;

        /* Skala płynnej typografii: 320px (20rem) -> 1024px (64rem) */

        /* 12px -> 13px (Tagi, badge, mikro-etykiety nad sekcjami) */
        --text-xs: clamp(0.75rem, 0.722rem + 0.142vw, 0.8125rem);

        /* 13px -> 14px (Kod w oknie terminala, stopka, metadane) */
        --text-sm: clamp(0.8125rem, 0.784rem + 0.142vw, 0.875rem);

        /* 14px -> 15px (Opisy wewnątrz kart usług i wdrożeń) */
        --text-card: clamp(0.875rem, 0.847rem + 0.142vw, 0.9375rem);

        /* 15px -> 16px (Bazowy tekst, inputy formularza, przyciski) */
        --text-base: clamp(0.9375rem, 0.909rem + 0.142vw, 1rem);

        /* 16px -> 20px (Lead paragraf w Hero i podtytuły sekcji) */
        --text-lead: clamp(1rem, 0.886rem + 0.568vw, 1.25rem);

        /* 18px -> 22px (H3: Tytuły kart i punkty na osi czasu) */
        --text-h3: clamp(1.125rem, 1.011rem + 0.568vw, 1.375rem);

        /* 23px -> 32px (H2: Główne nagłówki sekcji) */
        --text-h2: clamp(1.4375rem, 1.182rem + 1.278vw, 2rem);

        /* 28px -> 48px (H1: Nagłówek w sekcji Hero) */
        --text-h1: clamp(1.75rem, 1.182rem + 2.841vw, 3rem);
    }

    html {
        font-family: var(--font-sans);
        font-size: 16px;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
        scroll-behavior: smooth;
        scroll-padding-top: 5.5rem;
    }

    body {
        background-color: #091020;
        min-height: 100svh;
        width: 100%;
        font-size: var(--text-base);
        line-height: 1.65;
        overflow-x: hidden;
    }

    h1,
    .h1 {
        font-size: var(--text-h1);
        line-height: 1.1;
        letter-spacing: -0.03em;
        font-weight: 700;
        text-wrap: balance;
    }

    h2,
    .h2 {
        font-size: var(--text-h2);
        line-height: 1.2;
        letter-spacing: -0.025em;
        font-weight: 700;
        text-wrap: balance;
    }

    h3,
    .h3 {
        font-size: var(--text-h3);
        line-height: 1.3;
        letter-spacing: -0.015em;
        font-weight: 600;
    }

    p {
        text-wrap-style: balance;
    }

    .lead {
        font-size: var(--text-lead);
        line-height: 1.6;
    }

    .card-text {
        font-size: var(--text-card);
        line-height: 1.6;
    }

    /* Klasy techniczne (JetBrains Mono) */
    code,
    pre,
    .mono-terminal {
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        line-height: 1.6;
        font-feature-settings: "liga" 0; /* Wyłącza ligatury w terminalu dla czytelności komend */
    }

    .tag,
    .badge,
    .eyebrow {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        line-height: 1.4;
        letter-spacing: 0.02em;
    }

    main,
    section {
        width: 100%;
    }

    /* GLOBALNA KLASA HOVER DLA KART I BLOKÓW (na wzór przycisku Pobierz CV) */
    .card-hover {
        transition:
            transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
            border-color 0.25s ease,
            background-color 0.25s ease,
            box-shadow 0.25s ease;
    }

    .card-hover:hover {
        transform: translateY(-4px);
        border-color: #7cc6fe !important;
        background-color: #132438 !important;
        box-shadow:
            0 12px 28px -10px rgba(9, 16, 32, 0.85),
            0 0 18px -4px rgba(124, 198, 254, 0.18);
    }

    .status-indicator,
    .status-terminal-circle,
    .circle-service,
    .proof-circle,
    .footer-circle {
        background-color: #42d6a0;
        box-shadow: 0 0 6px 2px rgba(66, 214, 160, 0.65);
        animation: status-pulse 3s infinite ease-in-out;
    }

    @keyframes status-pulse {
        0%,
        100% {
            opacity: 1;
            box-shadow:
                0 0 8px 2px rgba(66, 214, 160, 0.7),
                0 0 16px 4px rgba(66, 214, 160, 0.3);
        }
        50% {
            opacity: 0.4;
            box-shadow:
                0 0 4px 1px rgba(66, 214, 160, 0.25),
                0 0 8px 2px rgba(66, 214, 160, 0.1);
        }
    }
</style>
